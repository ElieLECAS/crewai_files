# Ollama sur l'host (Docker : host.docker.internal, local : localhost)
MODEL=glm-ocr:q8_0
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Si "Connection refused" sous Linux : 1) Sur l'host, lancer Ollama en écoutant toutes les interfaces :
#    OLLAMA_HOST=0.0.0.0 ollama serve
# 2) Si host.docker.internal ne résout pas, utiliser l'IP de la gateway (ex. réseau 172.21.x.x → 172.21.0.1) :
# OLLAMA_BASE_URL=http://172.21.0.1:11434
# OLLAMA_BASE_URL=http://localhost:11434
VERBOSE=true
TIMEOUT=600
# Un seul worker recommandé (évite blocages et logs dupliqués)
# MAX_WORKERS=1
