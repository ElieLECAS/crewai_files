# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434

# Ollama Model Configuration
# Modèle à utiliser (doit être disponible dans Ollama)
MODEL=llama3.2:3b

# Performance Optimization
# Température du LLM (0.0-1.0, plus bas = plus rapide et déterministe)
TEMPERATURE=0.3

# Timeout pour les appels Ollama en secondes (600s = 10min recommandé pour modèles locaux)
TIMEOUT=600

# Mode verbose (true/false) - false pour moins de logs, plus rapide
VERBOSE=false

# Nombre de tentatives en cas d'erreur
MAX_RETRIES=2

# Délai entre les tentatives en secondes
RETRY_DELAY=3

# CrewAI Configuration (optional)
# CREWAI_MAX_ITER=15

